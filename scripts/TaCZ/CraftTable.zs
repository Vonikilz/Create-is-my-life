//Оружейный верстак
craftingTable.removeByName("tacz:gun_smith_table");
craftingTable.addShaped("gun_smith_table", <item:tacz:gun_smith_table>, [
    [<item:createpropulsion:platinum_casing>, <item:createpropulsion:platinum_casing>, <item:createpropulsion:platinum_casing>], 
    [<item:cgs:steel_ingot>, <item:cgs:steel_block>, <item:cgs:steel_ingot>], 
    [<item:cgs:steel_ingot>, <item:minecraft:air>, <item:cgs:steel_ingot>]
    ]
);
	# Default: 0.35
	# Range: 0.0 ~ 1.0
	hardGearChance = 0.3
	#Full armor sets near surface. Accepts either a String "[mod:helmet, mod:chest, mod:legs, mod:boots, 25]" or a list ["mod:helmet","mod:chest","mod:legs","mod:boots",25]. Percent: 25->25%, 0.5->0.5%.
